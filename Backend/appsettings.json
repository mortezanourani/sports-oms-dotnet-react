{
  "Jwt": {
    "Issuer": "SportsManagementApi",
    "Audience": "SportsManagementClient",
    "AccessTokenExpiryMinutes": 120,
    "RefreshTokenExpirationDays": 7
  },
  "FileStorage": {
    "MaxFileSizeBytes": 10485760,
    "RootPath": "",
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedDocumentExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".doc", ".docx", ".xlsx" ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
